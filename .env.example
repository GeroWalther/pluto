# ---------------------------------------------------------------------------
# Pluto — environment variables
# Copy to `.env` and fill in. Everything except the OAuth blocks is required.
# ---------------------------------------------------------------------------

# Postgres. `docker compose up -d` gives you exactly this connection string.
DATABASE_URL="postgresql://pluto:pluto@localhost:5432/pluto?schema=public"

# Public origin of the app. No trailing slash.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# NextAuth. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Signing key for download links. Generate with: openssl rand -base64 32
DOWNLOAD_TOKEN_SECRET=""

# Stripe (test mode keys are fine for development)
STRIPE_SECRET_KEY="sk_test_..."
# Printed by `npm run stripe:listen`
STRIPE_WEBHOOK_SECRET="whsec_..."

# UploadThing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Transactional email via Resend SMTP. Leave RESEND_API_KEY empty in
# development and emails are logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Pluto Market <onboarding@resend.dev>"

# Optional OAuth providers. Omit either block to hide that sign-in button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Seeded admin account (npm run db:seed)
SEED_ADMIN_EMAIL="admin@pluto.test"
SEED_ADMIN_PASSWORD="password123"
